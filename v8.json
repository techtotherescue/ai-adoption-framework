  "conditions": [
    {
      "id": "S1.def.1",
      "list": "S1.def",
      "text": "Deep skepticism or active avoidance of AI tools.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.2",
      "list": "S1.def",
      "text": "Concerns about job replacement, ethics, privacy, bias, dignity, or mission authenticity.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.4",
      "list": "S1.def",
      "text": "AI is understood mainly as a threat, distraction, or hype cycle.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.6",
      "list": "S1.def",
      "text": "The organization does not use AI in its work. AI has at most been discussed.",
      "where": "Stage 1: Resisting › Placement",
      "role": "placement"
    },
    {
      "id": "S2.def.1",
      "list": "S2.def",
      "text": "Individuals use general AI tools for writing, research, summarization, reports, administration, analysis, or ideation.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.2",
      "list": "S2.def",
      "text": "Usage is fragmented and uneven.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.3",
      "list": "S2.def",
      "text": "Early champions share wins informally.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.4",
      "list": "S2.def",
      "text": "The organization has no coherent operating model.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.5",
      "list": "S2.def",
      "text": "Experiments may occur in real workflows but are not yet repeatable organizational practice.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.7",
      "list": "S2.def",
      "text": "People use AI in their own work, however unevenly.",
      "where": "Stage 2: Exploring › Placement",
      "role": "stage_line",
      "loop_step": 1
    },
    {
      "id": "S3.def.1",
      "list": "S3.def",
      "text": "AI use becomes expected in selected areas rather than exceptional.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "stage_line",
      "loop_step": 6
    },
    {
      "id": "S3.def.2",
      "list": "S3.def",
      "text": "The organization standardizes tools, licenses, practices, and safe-use norms.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.3",
      "list": "S3.def",
      "text": "A named AI owner, champion, or adoption group has time and authority.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "deciding",
      "domain": "leadership_ownership",
      "loop_step": 6
    },
    {
      "id": "S3.def.4",
      "list": "S3.def",
      "text": "The organization prioritizes workflows deliberately.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.5",
      "list": "S3.def",
      "text": "It can run the Adoption Loop on selected workflows.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.6",
      "list": "S3.def",
      "text": "Most adoption remains internal, but pilots may include mission-critical work if risk and ownership are appropriate.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.7",
      "list": "S3.def",
      "text": "The organization runs AI pilots on selected workflows, or has run the Adoption Loop on them more than once.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "stage_line",
      "loop_step": 3
    },
    {
      "id": "S3.def.8",
      "list": "S3.def",
      "text": "People share what works and what fails across the organization.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "deciding",
      "domain": "evidence_learning",
      "loop_step": 7
    },
    {
      "id": "S4.def.1",
      "list": "S4.def",
      "text": "AI is integral to a workflow that matters to mission delivery or organizational performance.",
      "where": "Stage 4: Innovating › Placement",
      "role": "stage_line",
      "loop_step": 2
    },
    {
      "id": "S4.def.2",
      "list": "S4.def",
      "text": "The workflow is redesigned rather than merely supplemented with an AI tool.",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "people_workflows_change",
      "loop_step": 5,
      "condition": "S4.def.2"
    },
    {
      "id": "S4.def.3",
      "list": "S4.def",
      "text": "Human roles, review, escalation, and exception handling are explicit.",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "people_workflows_change",
      "loop_step": 5,
      "condition": "S4.def.2"
    },
    {
      "id": "S4.def.4",
      "list": "S4.def",
      "text": "The workflow operates repeatedly outside a temporary demo environment.",
      "where": "Stage 4: Innovating › Placement",
      "role": "stage_line",
      "loop_step": 6
    },
    {
      "id": "S4.def.5",
      "list": "S4.def",
      "text": "Evidence is used to improve the workflow.",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "evidence_learning",
      "loop_step": 7
    },
    {
      "id": "S4.def.6",
      "list": "S4.def",
      "text": "Governance, maintenance, dependency, and failure handling are active operating practices.",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "governance_risk",
      "loop_step": 6
    },
    {
      "id": "S4.def.7",
      "list": "S4.def",
      "text": "Beneficiary-facing deployment may exist, but it is not required.",
      "where": "Stage 4: Innovating › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.1",
      "list": "S5.def",
      "text": "AI capacity serves beyond the organization's own boundaries.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.2",
      "list": "S5.def",
      "text": "The organization creates reusable tools, datasets, context assets, standards, playbooks, APIs, protocols, services, or learning systems.",
      "where": "Stage 5: Enabling › Placement",
      "role": "stage_line",
      "loop_step": 7,
      "condition": "S5.def.7"
    },
    {
      "id": "S5.def.3",
      "list": "S5.def",
      "text": "Other organizations obtain demonstrated value from the capability.",
      "where": "Stage 5: Enabling › Placement",
      "role": "deciding",
      "domain": "evidence_learning",
      "loop_step": 7
    },
    {
      "id": "S5.def.4",
      "list": "S5.def",
      "text": "Success is measured partly by how others adopt, improve, or move faster.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.5",
      "list": "S5.def",
      "text": "The organization has legitimacy and credibility to support others.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.6",
      "list": "S5.def",
      "text": "AI capability is distributed across leadership, product/program, operations, adoption, and technical functions.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.7",
      "list": "S5.def",
      "text": "At least two independent organizations use one of them in their own work today.",
      "where": "Stage 5: Enabling › Placement",
      "role": "stage_line",
      "loop_step": 7,
      "condition": "S5.def.7"
    },
    {
      "id": "S5.def.8",
      "list": "S5.def",
      "text": "Both cover the capability others use.",
      "where": "Stage 5: Enabling › Placement",
      "role": "deciding",
      "domain": "resources_sustainability",
      "loop_step": 6,
      "condition": "S5.guardrail.3"
    },
    {
      "id": "S3.signal.2",
      "list": "S3.signal",
      "text": "Shared licenses or approved tool stack.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 3
    },
    {
      "id": "S3.signal.3",
      "list": "S3.signal",
      "text": "Team education and learning rhythm.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "people_workflows_change",
      "loop_step": 1
    },
    {
      "id": "S3.signal.4",
      "list": "S3.signal",
      "text": "Safe-use and data-handling norms.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "governance_risk",
      "loop_step": 3
    },
    {
      "id": "S3.signal.5",
      "list": "S3.signal",
      "text": "Workflow and use-case prioritization.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "leadership_ownership",
      "loop_step": 2
    },
    {
      "id": "S3.signal.6",
      "list": "S3.signal",
      "text": "Baseline and intended outcome for priority workflows.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "evidence_learning",
      "loop_step": 2
    },
    {
      "id": "S3.signal.7",
      "list": "S3.signal",
      "text": "Data/context inventory and maintenance responsibility.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "data_context",
      "loop_step": 4
    },
    {
      "id": "S3.signal.8",
      "list": "S3.signal",
      "text": "Explicit map of changing tasks, roles, review, and exceptions.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "people_workflows_change",
      "loop_step": 5
    },
    {
      "id": "S3.signal.9",
      "list": "S3.signal",
      "text": "Technical support model.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 6
    },
    {
      "id": "S3.signal.10",
      "list": "S3.signal",
      "text": "Vendor and partner dependency view.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 4
    },
    {
      "id": "S3.signal.11",
      "list": "S3.signal",
      "text": "Budget, credits, and protected implementation time.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "resources_sustainability",
      "loop_step": 6
    },
    {
      "id": "S3.signal.12",
      "list": "S3.signal",
      "text": "Regular implementation cadence.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "leadership_ownership",
      "loop_step": 7
    },
    {
      "id": "S3.signal.13",
      "list": "S3.signal",
      "text": "Criteria for deciding which workflows are ready for operational deployment.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "governance_risk",
      "loop_step": 6
    },
    {
      "id": "S3.signal.14",
      "list": "S3.signal",
      "text": "A successor arranged, so the work survives their leaving.",
      "applies": "Where there is an AI owner",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "leadership_ownership",
      "loop_step": 6
    },
    {
      "id": "S3.signal.15",
      "list": "S3.signal",
      "text": "The people who do the work take part in shaping how AI is used.",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "people_workflows_change",
      "loop_step": 5
    },
    {
      "id": "S3.signal.16",
      "list": "S3.signal",
      "text": "Someone independent checks its quality, and a handover is agreed.",
      "applies": "Where the work is done pro bono",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 6
    },
    {
      "id": "S3.signal.17",
      "list": "S3.signal",
      "text": "Results are judged by outcomes, not by the volume of output.",
      "applies": "Where the organization measures its AI work",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "evidence_learning",
      "loop_step": 7
    },
    {
      "id": "S3.signal.18",
      "list": "S3.signal",
      "text": "At least two people answered, and they agree on the deciding answers of this stage and of the stages below.",
      "applies": "Where this is the highest stage whose deciding conditions are met",
      "where": "Stage 3: Systematizing › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "leadership_ownership"
    },
    {
      "id": "S4.gate.1",
      "list": "S4.gate",
      "text": "a defined user need and intended outcome;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "evidence_learning",
      "loop_step": 2
    },
    {
      "id": "S4.gate.2",
      "list": "S4.gate",
      "text": "a baseline and evaluation plan;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "evidence_learning",
      "loop_step": 2
    },
    {
      "id": "S4.gate.3",
      "list": "S4.gate",
      "text": "accountable AI adoption and technical ownership;",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "leadership_ownership",
      "loop_step": 6
    },
    {
      "id": "S4.gate.5",
      "list": "S4.gate",
      "text": "data/context ownership and quality controls;",
      "where": "Stage 4: Innovating › Placement",
      "role": "deciding",
      "domain": "data_context",
      "loop_step": 6
    },
    {
      "id": "S4.gate.6",
      "list": "S4.gate",
      "text": "a risk and consequence assessment;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "governance_risk",
      "loop_step": 6
    },
    {
      "id": "S4.gate.7",
      "list": "S4.gate",
      "text": "human review, escalation, exception, and appeal rules where relevant;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "governance_risk",
      "loop_step": 5
    },
    {
      "id": "S4.gate.8",
      "list": "S4.gate",
      "text": "security and privacy stance;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 6
    },
    {
      "id": "S4.gate.9",
      "list": "S4.gate",
      "text": "monitoring after deployment;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "evidence_learning",
      "loop_step": 6
    },
    {
      "id": "S4.gate.10",
      "list": "S4.gate",
      "text": "staff or user acceptability checks;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "people_workflows_change",
      "loop_step": 4
    },
    {
      "id": "S4.gate.11",
      "list": "S4.gate",
      "text": "maintenance and incident ownership;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 6
    },
    {
      "id": "S4.gate.12",
      "list": "S4.gate",
      "text": "cost and consumption controls;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "resources_sustainability",
      "loop_step": 6
    },
    {
      "id": "S4.gate.13",
      "list": "S4.gate",
      "text": "vendor, model, data, and partner dependency review;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 4
    },
    {
      "id": "S4.gate.14",
      "list": "S4.gate",
      "text": "portability, rollback, or migration path;",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "technology_resilience",
      "loop_step": 6
    },
    {
      "id": "S4.gate.15",
      "list": "S4.gate",
      "text": "a decision process for continuation, expansion, constraint, or retirement.",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
      "role": "readiness",
      "domain": "leadership_ownership",
      "loop_step": 7
    },
    {
      "id": "S4.gate.16",
      "list": "S4.gate",
      "text": "A review of failures and a learning cadence after deployment.",
      "where": "Stage 4: Innovating › Placement › Readiness checklist",
