  "conditions": [
    {
      "id": "S1.def.1",
      "list": "S1.def",
      "text": "Deep skepticism or active avoidance of AI tools.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.2",
      "list": "S1.def",
      "text": "Concerns about job replacement, ethics, privacy, bias, dignity, or mission authenticity.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.4",
      "list": "S1.def",
      "text": "AI is understood mainly as a threat, distraction, or hype cycle.",
      "where": "Stage 1: Resisting › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S1.def.5",
      "list": "S1.def",
      "text": "The organization does not use AI in its work, and nobody owns its adoption.",
      "where": "Stage 1: Resisting › Placement",
      "role": "placement"
    },
    {
      "id": "S2.def.1",
      "list": "S2.def",
      "text": "Individuals use general AI tools for writing, research, summarization, reports, administration, analysis, or ideation.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.2",
      "list": "S2.def",
      "text": "Usage is fragmented and uneven.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.3",
      "list": "S2.def",
      "text": "Early champions share wins informally.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.4",
      "list": "S2.def",
      "text": "The organization has no coherent operating model.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.5",
      "list": "S2.def",
      "text": "Experiments may occur in real workflows but are not yet repeatable organizational practice.",
      "where": "Stage 2: Exploring › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S2.def.6",
      "list": "S2.def",
      "text": "People use AI in their own work, however unevenly, or someone owns its adoption.",
      "where": "Stage 2: Exploring › Placement",
      "role": "placement"
    },
    {
      "id": "S3.def.1",
      "list": "S3.def",
      "text": "AI use becomes expected in selected areas rather than exceptional.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "required"
    },
    {
      "id": "S3.def.2",
      "list": "S3.def",
      "text": "The organization standardizes tools, licenses, practices, and safe-use norms.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.3",
      "list": "S3.def",
      "text": "A named AI owner, champion, or adoption group has time and authority.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "required"
    },
    {
      "id": "S3.def.4",
      "list": "S3.def",
      "text": "The organization prioritizes workflows deliberately.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.5",
      "list": "S3.def",
      "text": "It can run the Adoption Loop on selected workflows.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.6",
      "list": "S3.def",
      "text": "Most adoption remains internal, but pilots may include mission-critical work if risk and ownership are appropriate.",
      "where": "Stage 3: Systematizing › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S3.def.7",
      "list": "S3.def",
      "text": "The organization runs AI pilots on selected workflows, or has run the Adoption Loop on them more than once.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "placement"
    },
    {
      "id": "S3.def.8",
      "list": "S3.def",
      "text": "People share what works and what fails across the organization.",
      "where": "Stage 3: Systematizing › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.1",
      "list": "S4.def",
      "text": "AI is integral to a workflow that matters to mission delivery or organizational performance.",
      "where": "Stage 4: Innovating › Placement",
      "role": "placement"
    },
    {
      "id": "S4.def.2",
      "list": "S4.def",
      "text": "The workflow is redesigned rather than merely supplemented with an AI tool.",
      "where": "Stage 4: Innovating › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.3",
      "list": "S4.def",
      "text": "Human roles, review, escalation, and exception handling are explicit.",
      "where": "Stage 4: Innovating › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.4",
      "list": "S4.def",
      "text": "The workflow operates repeatedly outside a temporary demo environment.",
      "where": "Stage 4: Innovating › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.5",
      "list": "S4.def",
      "text": "Evidence is used to improve the workflow.",
      "where": "Stage 4: Innovating › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.6",
      "list": "S4.def",
      "text": "Governance, maintenance, dependency, and failure handling are active operating practices.",
      "where": "Stage 4: Innovating › Placement",
      "role": "required"
    },
    {
      "id": "S4.def.7",
      "list": "S4.def",
      "text": "Beneficiary-facing deployment may exist, but it is not required.",
      "where": "Stage 4: Innovating › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.1",
      "list": "S5.def",
      "text": "AI capacity serves beyond the organization's own boundaries.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.2",
      "list": "S5.def",
      "text": "The organization creates reusable tools, datasets, context assets, standards, playbooks, APIs, protocols, services, or learning systems.",
      "where": "Stage 5: Enabling › Placement",
      "role": "placement"
    },
    {
      "id": "S5.def.3",
      "list": "S5.def",
      "text": "Other organizations obtain demonstrated value from the capability.",
      "where": "Stage 5: Enabling › Placement",
      "role": "required"
    },
    {
      "id": "S5.def.4",
      "list": "S5.def",
      "text": "Success is measured partly by how others adopt, improve, or move faster.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.5",
      "list": "S5.def",
      "text": "The organization has legitimacy and credibility to support others.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.6",
      "list": "S5.def",
      "text": "AI capability is distributed across leadership, product/program, operations, adoption, and technical functions.",
      "where": "Stage 5: Enabling › What it looks like › Typical traits",
      "role": "trait"
    },
    {
      "id": "S5.def.7",
      "list": "S5.def",
      "text": "At least two independent organizations use one of them in their own work today.",
      "where": "Stage 5: Enabling › Placement",
      "role": "placement"
    },
    {
      "id": "S5.def.8",
      "list": "S5.def",
      "text": "Both cover the capability others use.",
      "where": "Stage 5: Enabling › Placement",
      "role": "required"
    },
    {
